# AutoPilot Configuration
# Copy to .env and fill in your values
#
# Quick Start: Only one LLM provider key is required to run.
# Anthropic is the default; set GEMINI_API_KEY / OPENAI_API_KEY instead to use
# another provider (see "ALTERNATIVE LLM PROVIDERS" below).
# Add ONE messaging channel (Telegram recommended) to interact.

# =============================================================================
# REQUIRED (Must have at least one LLM provider to run)
# =============================================================================

# Anthropic API Key - Get from: https://console.anthropic.com
# Not required if you configure an alternative provider below.
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# ALTERNATIVE LLM PROVIDERS (optional - any one of these replaces Anthropic)
# =============================================================================
# The agent routes each request to the provider resolved from its model id:
#   1. explicit prefix      agents.defaults.model.primary = "gemini/gemini-2.5-flash"
#   2. AUTOPILOT_LLM_PROVIDER forces a provider for unprefixed model ids
#   3. model-name inference claude-* -> anthropic, gemini-* -> gemini, gpt-* -> openai
#   4. first configured provider (oss / local model ids land here)
#
# Anthropic stays the default. Configure one key below to run without Anthropic.

# Force one provider for all unprefixed model ids (uncomment to use):
# AUTOPILOT_LLM_PROVIDER=gemini

# Google Gemini - Get from: https://aistudio.google.com/apikey
# (GOOGLE_API_KEY is accepted as a fallback.)
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Default model used when a Claude-named model is rerouted here.
# NOTE: gemini-1.5-pro is retired by Google - use gemini-2.5-flash or newer.
AUTOPILOT_GEMINI_MODEL=gemini-2.5-flash

# OpenAI - Get from: https://platform.openai.com/api-keys
# OPENAI_BASE_URL also works for OpenAI-compatible servers (OpenRouter, LM Studio, vLLM).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AUTOPILOT_OPENAI_MODEL=gpt-4o

# Groq - Get from: https://console.groq.com/keys
# GROQ_API_KEY=
# AUTOPILOT_GROQ_MODEL=llama-3.3-70b-versatile

# Together AI - Get from: https://api.together.ai
# TOGETHER_API_KEY=
# AUTOPILOT_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Fireworks AI - Get from: https://fireworks.ai/api-keys
# FIREWORKS_API_KEY=
# AUTOPILOT_FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Local Ollama - Set to your Ollama server root (no API key needed).
# OLLAMA_URL=http://localhost:11434
# AUTOPILOT_OLLAMA_MODEL=llama3

# Anthropic model override (when using Anthropic)
# AUTOPILOT_ANTHROPIC_MODEL=claude-opus-4-6

# =============================================================================
# PICK ONE MESSAGING CHANNEL (At least one recommended)
# =============================================================================

# Telegram (Recommended - easiest setup)
# Get token from: https://t.me/BotFather (send /newbot)
TELEGRAM_BOT_TOKEN=

# Discord
# Get token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# Slack
# Get tokens from: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# WebChat (built-in, works immediately at http://localhost:18789/webchat)
WEBCHAT_TOKEN=

# =============================================================================
# TRADING CREDENTIALS (Optional - for executing trades)
# =============================================================================

# Polymarket - Get from: https://polymarket.com/settings/api
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=0x...
# POLY_FUNDER_ADDRESS=  # Required for trading, your wallet address

# Kalshi - Get from: https://kalshi.com/account/api
KALSHI_API_KEY=
KALSHI_API_SECRET=
# Legacy auth (use API keys instead):
# KALSHI_EMAIL=
# KALSHI_PASSWORD=

# Manifold - Get from: https://manifold.markets/account
MANIFOLD_API_KEY=

# Metaculus - Get from: https://www.metaculus.com/accounts/profile/
METACULUS_TOKEN=

# =============================================================================
# ADDITIONAL CHANNELS (Optional)
# =============================================================================

# Matrix
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=@bot:matrix.org

# Signal (requires signal-cli linked to phone)
# SIGNAL_PHONE_NUMBER=
# SIGNAL_CLI_PATH=signal-cli

# iMessage (macOS only, uses Messages.app)
IMESSAGE_ENABLED=0

# LINE - Get from: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Google Chat - Requires service account
GOOGLECHAT_CREDENTIALS_PATH=
# Or use individual values:
# GOOGLECHAT_CLIENT_EMAIL=
# GOOGLECHAT_PRIVATE_KEY=
# GOOGLECHAT_PROJECT_ID=

# Microsoft Teams
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# =============================================================================
# EXTERNAL SERVICES (Optional - enables extra features)
# =============================================================================

# OpenAI (for embeddings if preferred over local)
OPENAI_API_KEY=

# Twitter/X (for news feeds)
TWITTER_BEARER_TOKEN=

# SMTP (for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# GATEWAY & SECURITY
# =============================================================================

# Gateway auth token (for API access)
AUTOPILOT_TOKEN=

# Public URL for webhooks (if behind proxy/tunnel)
AUTOPILOT_PUBLIC_HOST=localhost
AUTOPILOT_PUBLIC_SCHEME=http

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# LOCALIZATION
# =============================================================================

# Language: en, zh, es, ja, ko, de, fr, pt, ru, ar
# If not set, auto-detects from system LANG environment variable
AUTOPILOT_LOCALE=en

# =============================================================================
# ADVANCED (Usually don't need to change)
# =============================================================================

# Streaming responses
AUTOPILOT_STREAM_RESPONSES=true
AUTOPILOT_STREAM_RESPONSE_INTERVAL_MS=500

# Database backups (minutes, 0 to disable)
AUTOPILOT_DB_BACKUP_INTERVAL_MINUTES=60
AUTOPILOT_DB_BACKUP_MAX=10

# Market index settings
MARKET_INDEX_ENABLED=true
MARKET_INDEX_PLATFORMS=polymarket,kalshi,manifold,metaculus

# Memory auto-capture
MEMORY_AUTO_ENABLED=true

# Session cleanup
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_MAX_AGE_DAYS=30

# Position tracking
POSITIONS_PRICE_UPDATE_ENABLED=true
POSITIONS_PNL_SNAPSHOTS_ENABLED=true

# =============================================================================
# MCP SERVER SECURITY (Optional - for MCP tool access control)
# =============================================================================

# Tool allowlist/blocklist (comma-separated tool names)
# AUTOPILOT_MCP_ALLOWED_TOOLS=autopilot_feeds_polymarket,autopilot_markets_search
# AUTOPILOT_MCP_BLOCKED_TOOLS=autopilot_trading_polymarket

# Tool profile: read-only, trading, full (default: full)
# AUTOPILOT_MCP_TOOL_PROFILE=full

# Rate limit: max MCP calls per minute per client (default: 60)
# AUTOPILOT_MCP_RATE_LIMIT=60

# Audit logging to stderr (default: true, set to false to disable)
# AUTOPILOT_MCP_AUDIT=true

# =============================================================================
# SECURITY (Production Settings)
# =============================================================================

# Credential encryption key (required for storing credentials securely)
# Generate with: openssl rand -hex 32
AUTOPILOT_CREDENTIAL_KEY=

# Escrow keypair encryption key (falls back to AUTOPILOT_CREDENTIAL_KEY if not set)
# Required for ACP escrow - stores Solana keypairs encrypted in database
# Generate with: openssl rand -hex 32
AUTOPILOT_ESCROW_KEY=

# Canvas JavaScript evaluation (disabled by default for security)
# Only enable if you need agent-driven UI with dynamic JS
CANVAS_ALLOW_JS_EVAL=false

# IP-based rate limiting (requests per minute per IP)
AUTOPILOT_IP_RATE_LIMIT=100

# HTTPS enforcement
AUTOPILOT_FORCE_HTTPS=false
AUTOPILOT_HSTS_ENABLED=false

# =============================================================================
# BITTENSOR MINING (Optional - for TAO subnet mining)
# =============================================================================

# Enable Bittensor subnet mining
BITTENSOR_ENABLED=false

# Network: mainnet, testnet, local
BITTENSOR_NETWORK=mainnet

# Custom subtensor WebSocket URL (optional - defaults to Finney endpoint)
# BITTENSOR_SUBTENSOR_URL=wss://entrypoint-finney.opentensor.ai:443

# Wallet paths (optional - for on-chain operations)
# BITTENSOR_COLDKEY_PATH=~/.bittensor/wallets/default/coldkey
# BITTENSOR_COLDKEY_PASSWORD=

# Python path for btcli commands (optional - defaults to python3)
# BITTENSOR_PYTHON_PATH=/usr/bin/python3

# Earnings poll interval in ms (optional - defaults to 300000 / 5 min)
# BITTENSOR_EARNINGS_POLL_INTERVAL_MS=300000

# ============================================================================
# API / Compute Marketplace (Revenue Collection)
# ============================================================================

# Treasury wallet - ALL payments go here (required for paid API)
# This is YOUR wallet address on Base network
AUTOPILOT_TREASURY_WALLET=

# Webhook signature secret for callbacks
AUTOPILOT_WEBHOOK_SECRET=

# LLM API keys for compute marketplace
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
